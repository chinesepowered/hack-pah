# Copy to .env and fill in. Never commit .env.

# Superlinked SIE Serverless (all model calls)
SIE_API_KEY=sk-sie-...

# SingleStore Helios. https://USER:PASSWORD@HOST/DB uses the Data API (works through any firewall);
# mysql://USER:PASSWORD@HOST:3306/DB uses the MySQL protocol.
SINGLESTORE_URL=https://admin:PASSWORD@svc-XXXX-dml.REGION.svc.singlestore.com/capyteam

# Amplitude Agent Analytics (project API key). Secret key is optional: night school then pulls
# Amplitude's own session signals through the Agent Analytics export API.
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=

# Statsig server secret; create an experiment named capyteam_agent_release (groups Control / Test)
STATSIG_SERVER_SECRET=secret-...

# Airbyte live mode (optional). Either a real Stripe key for the local Airbyte Stripe agent connector,
# or an Airbyte application for the hosted connector (CAPY_AIRBYTE_HOSTED=1). Neither = demo yard.
STRIPE_API_KEY=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# ElevenLabs (only for rebuilding the demo video narration)
ELEVENLABS_API_KEY=

# Cognee Cloud (the casebook)
COGNEE_BASE_URL=https://tenant-XXXX.aws.cognee.ai
COGNEE_API_KEY=
